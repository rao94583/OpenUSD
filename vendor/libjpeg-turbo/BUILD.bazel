# libjpeg-turbo, for libtiff and OpenImageIO (see README.md). Mirrors
# CMakeLists.txt with default options except WITH_SIMD=0, as
# build_scripts/build_usd.py uses on some platforms (no assembler needed).

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cmake_configure_file.bzl", "cmake_configure_file")

package(default_visibility = ["//visibility:public"])

_VALUES = {
    "VERSION": "3.1.4.1",
    "LIBJPEG_TURBO_VERSION_NUMBER": "3001004",
    "COPYRIGHT_YEAR": "1991-2026",
    "JPEG_LIB_VERSION": "62",
    "C_ARITH_CODING_SUPPORTED": "ON",
    "D_ARITH_CODING_SUPPORTED": "ON",
    "WITH_SIMD": "OFF",
    "CMAKE_PROJECT_NAME": "libjpeg-turbo",
    # CMake uses the configure date; a fixed value keeps builds reproducible.
    "BUILD": "bazel",
    "HIDDEN": "__attribute__((visibility(\"hidden\")))",
    "INLINE": "__inline__ __attribute__((always_inline))",
    "THREAD_LOCAL": "__thread",
    "SIZE_T": "8",
    "HAVE_BUILTIN_CTZL": "ON",
}

[
    cmake_configure_file(
        name = name,
        src = "src/%s.h.in" % name,
        out = "src/%s.h" % name,
        values = _VALUES,
    )
    for name in ["jconfig", "jconfigint", "jversion"]
]

# CMakeLists.txt's JPEG_SOURCES, with arithmetic coding. The wrapper/*-N.c
# files compile a base source for 8-, 12- or 16-bit samples.
