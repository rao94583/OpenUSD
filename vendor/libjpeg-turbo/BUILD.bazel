    "src/jerror.h",
    "src/jmorecfg.h",
    "src/jpeglib.h",
]

cc_library(
    name = "libjpeg-turbo",
    srcs = _SRCS + [
        ":jconfigint",
        ":jversion",
    ],
    hdrs = _PUBLIC_HDRS + [":jconfig"],
    copts = ["-w"],
    includes = ["src"],
    # The base sources the wrappers include, and private headers.
    textual_hdrs = glob(
        [
            "src/*.c",
            "src/*.h",
        ],
        exclude = _SRCS + _PUBLIC_HDRS,
    ),
)
