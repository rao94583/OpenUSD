# Jinja2, used by the schema code generators (usdGenSchema, usdInitSchema,
# usdgenschemafromsdr). See README.md.

load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "jinja2",
    srcs = glob(["src/jinja2/*.py"]),
    data = ["src/jinja2/py.typed"],
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = ["//vendor/markupsafe"],
)
