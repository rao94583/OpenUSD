# oneTBB 2021.12.0, vendored. See README.md in this directory.
#
# Adapted from upstream's community-maintained BUILD.bazel: rules are loaded
# from rules_cc (required by Bazel 9) and x86-only flags are selected per CPU
# so the library builds on arm64.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["LICENSE.txt"])

_PUBLIC_HDRS = glob([
    "include/tbb/*.h",
    "include/oneapi/*.h",
    "include/oneapi/tbb/*.h",
    "include/oneapi/tbb/detail/*.h",
])

_X86_64 = "@platforms//cpu:x86_64"

cc_library(
    name = "tbb",
    srcs = glob([
        "src/tbb/*.cpp",
        "src/tbb/*.h",
    ]) + select({
        _X86_64: glob(["src/tbb/tools_api/**/*.h"]),
        "//conditions:default": [],
    }),
    hdrs = _PUBLIC_HDRS,
    copts = ["-w"] + select({
        _X86_64: ["-mwaitpkg"],
        "//conditions:default": [],
    }),
    defines = select({
        _X86_64: ["__TBB_NO_IMPLICIT_LINKAGE"],
        "//conditions:default": ["USE_PTHREAD"],
    }) + select({
        "@platforms//os:macos": ["_XOPEN_SOURCE"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-pthread",
            "-lrt",
        ],
        "//conditions:default": ["-pthread"],
    }),
    local_defines = ["__TBB_BUILD"] + select({
        _X86_64: ["__TBB_USE_ITT_NOTIFY"],
        "//conditions:default": [],
    }),
    textual_hdrs = select({
        _X86_64: ["src/tbb/tools_api/ittnotify_static.c"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "tbbmalloc",
    srcs = glob([
        "src/tbbmalloc/*.h",
        "src/tbb/*.h",
        "src/tbbmalloc_proxy/*.h",
    ]) + [
        "src/tbbmalloc/backend.cpp",
        "src/tbbmalloc/backref.cpp",
        "src/tbbmalloc/frontend.cpp",
        "src/tbbmalloc/large_objects.cpp",
        "src/tbbmalloc/tbbmalloc.cpp",
    ],
    hdrs = _PUBLIC_HDRS,
    copts = ["-w"],
    includes = ["include"],
    local_defines = ["__TBBMALLOC_BUILD"],
)
