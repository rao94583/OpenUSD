# OpenUSD requires C++17 (see cmake/defaults/CXXDefaults.cmake).
common --cxxopt=-std=c++17
common --host_cxxopt=-std=c++17

# macOS: build for the host architecture with the deployment target used by
# Pixar's CI (VERSIONS.md lists macOS 15).
common:macos --macos_minimum_os=13.0
common:macos --host_macos_minimum_os=13.0

# Pick up the per-OS config above automatically.
common --enable_platform_specific_config

# Offline builds. Run `bazel vendor --config=offline //...` once while online:
# it copies every external repository (Bazel rule sets, the hermetic Python,
# the PyPI wheels) into bazel-vendor/ (untracked, ~600 MB). Builds with
# --config=offline then never download anything.
common:offline --vendor_dir=bazel-vendor

# No implicit __init__.py files in Python runfiles (deprecated in
# rules_python): our packages ship their own, and this also covers external
# targets such as rules_apple's json_tool, which MODULE.bazel's
# explicit_init_py setting doesn't reach.
common --incompatible_default_to_explicit_init_py

# Keep test output readable.
test --test_output=errors

# Local, untracked overrides (e.g. --disk_cache).
try-import %workspace%/user.bazelrc

# Vela's release build (bazel run --config=release //app/vela:package):
# optimized, in its own output tree beside the default fastbuild one.
common:release -c opt
