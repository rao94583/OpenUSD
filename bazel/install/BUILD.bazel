# The CMake install tree as Bazel outputs (see //bazel:pxr_install.bzl):
# lib/libusd_ms.dylib, its resources under lib/usd and plugin/usd, and the
# pxr Python package under lib/python. Plug finds resources relative to the
# monolithic library, so they must stay together.

load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("//bazel:pxr_install.bzl", "pxr_install_resources")
load("//bazel:pxr_libraries.bzl", "PXR_LIBRARIES", "PXR_PYTHON_MODULES", "PXR_RESOURCES")
load("//bazel:pxr_python.bzl", "PXR_LIBRARY_RPATHS", "PXR_PY_SHARED_LINKOPTS", "pxr_python_package")

package(default_visibility = ["//visibility:public"])

# oneTBB as its own shared library, as in CMake builds. It must not be part
# of usd_ms: static initializers in pxr libraries (e.g. work's thread limits)
# use tbb, and only a separate image is guaranteed to be initialized first.
cc_shared_library(
    name = "tbb",
    shared_lib_name = select({
        "@platforms//os:macos": "lib/libtbb.dylib",
        "//conditions:default": "lib/libtbb.so",
    }),
    deps = ["//vendor/onetbb:tbb"],
)

# OpenSubdiv as its own shared library, as in CMake builds (libosdCPU and
# libosdGPU combined).
cc_shared_library(
    name = "opensubdiv",
    shared_lib_name = select({
        "@platforms//os:macos": "lib/libopensubdiv.dylib",
        "//conditions:default": "lib/libopensubdiv.so",
    }),
    deps = [
        "//vendor/opensubdiv:osd_cpu",
        "//vendor/opensubdiv:osd_gpu",
    ],
)

# MaterialX as its own shared library: pxr headers include MaterialX headers,
# and tests link MaterialX directly. CMake builds link one shared library per
# MaterialX module; these are combined, like MATERIALX_BUILD_MONOLITHIC.
cc_shared_library(
    name = "materialx",
    shared_lib_name = select({
        "@platforms//os:macos": "lib/libMaterialX.dylib",
        "//conditions:default": "lib/libMaterialX.so",
    }),
    deps = [
        "//vendor/materialx:MaterialXCore",
        "//vendor/materialx:MaterialXFormat",
        "//vendor/materialx:MaterialXGenGlsl",
        "//vendor/materialx:MaterialXGenHw",
        "//vendor/materialx:MaterialXGenMsl",
        "//vendor/materialx:MaterialXGenShader",
        "//vendor/materialx:MaterialXRender",
        "//vendor/materialx:MaterialXRenderGlsl",
        "//vendor/materialx:MaterialXRenderHw",
    ],
)

# OpenColorIO as its own shared library, as in CMake builds, for Storm's
# color correction (hdx) and for apps that list the config's choices. One
# copy per process: two static copies conflict.
cc_shared_library(
    name = "opencolorio",
    shared_lib_name = select({
        "@platforms//os:macos": "lib/libOpenColorIO.dylib",
        "//conditions:default": "lib/libOpenColorIO.so",
    }),
    deps = ["//vendor/opencolorio"],
)

# The monolithic library (CMake's PXR_BUILD_MONOLITHIC usd_ms): every pxr
# library, so that Python extensions and programs share one copy of each
# registry.
cc_shared_library(
    name = "usd_ms",
    shared_lib_name = select({
        "@platforms//os:macos": "lib/libusd_ms.dylib",
        "//conditions:default": "lib/libusd_ms.so",
    }),
    deps = PXR_LIBRARIES,
    dynamic_deps = [
        ":materialx",
        ":opencolorio",
        ":opensubdiv",
        ":tbb",
    ],
    exports_filter = ["//pxr:__subpackages__"],
    user_link_flags = PXR_PY_SHARED_LINKOPTS + PXR_LIBRARY_RPATHS,
)

pxr_install_resources(
    name = "resources",
    resources = PXR_RESOURCES,
)

pxr_python_package(
    name = "python",
    prefix = "lib/python",
    modules = PXR_PYTHON_MODULES,
    dynamic_deps = [
        ":usd_ms",
        ":tbb",
        ":opensubdiv",
        ":materialx",
        ":opencolorio",
    ],
    runtime = [":resources"],
)
