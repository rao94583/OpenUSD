# Smoke tests, until the CMake tests are ported (Phase 3).

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:py_test.bzl", "py_test")

cc_test(
    name = "archSmoke",
    srcs = ["archSmoke.cpp"],
    deps = ["//pxr/base/arch"],
)

cc_test(
    name = "tfSmoke",
    srcs = ["tfSmoke.cpp"],
    deps = [
        "//pxr/base/tf",
        # tf contains Python support code, so executables link libpython.
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

py_test(
    name = "pythonSmoke",
    srcs = ["pythonSmoke.py"],
    deps = ["//bazel/install:python"],
)

py_test(
    name = "usdSmoke",
    srcs = ["usdSmoke.py"],
    deps = ["//bazel/install:python"],
)

py_test(
    name = "usdcatSmoke",
    srcs = ["usdcatSmoke.py"],
    args = ["$(rootpath //pxr/usd/bin/usdcat)"],
    data = ["//pxr/usd/bin/usdcat"],
)

py_test(
    name = "usdcheckerSmoke",
    srcs = ["usdcheckerSmoke.py"],
    args = ["$(rootpath //pxr/usdValidation/bin/usdchecker)"],
    data = ["//pxr/usdValidation/bin/usdchecker"],
)

py_test(
    name = "schemaToolsSmoke",
    srcs = ["schemaToolsSmoke.py"],
    args = [
        "$(rootpath //pxr/usd/usd:usdGenSchema)",
        "$(rootpath //pxr/usd/usd:usdInitSchema)",
        "$(rootpath //pxr/usd/bin/usdgenschemafromsdr)",
    ],
    data = [
        "//pxr/usd/bin/usdgenschemafromsdr",
        "//pxr/usd/usd:usdGenSchema",
        "//pxr/usd/usd:usdInitSchema",
    ],
)
