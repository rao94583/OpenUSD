cc_test(
    name = "archSmoke",
    srcs = ["archSmoke.cpp"],
    deps = ["//pxr/base/arch"],
)

cc_test(
    name = "tfSmoke",
    srcs = ["tfSmoke.cpp"],
    deps = [
