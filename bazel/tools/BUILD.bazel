load("@rules_python//python:py_binary.bzl", "py_binary")

# Runs one pxr_register_test (see //bazel:pxr_test.bzl).
exports_files(["pxr_test_runner.py"])

# configure_file() for vendored dependencies (see
# //bazel:cmake_configure_file.bzl).
py_binary(
    name = "cmake_configure_file",
    srcs = ["cmake_configure_file.py"],
    visibility = ["//visibility:public"],
)

# pyside6-uic, for PYSIDE_UI_FILES (see //bazel:pxr_library.bzl).
py_binary(
    name = "pyside6_uic",
    srcs = ["pyside6_uic.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pyside6_essentials"],
)
