# The importable pxr Python package: pxr/__init__.py and pxr/<Module>/ with
# each module's Python files and _<library>.so extension.

load("//bazel:pxr_libraries.bzl", "PXR_PYTHON_MODULES")
load("//bazel:pxr_python.bzl", "pxr_python_package")

pxr_python_package(
    name = "pxr",
    modules = PXR_PYTHON_MODULES,
    monolithic = "//pxr:usd_ms",
    visibility = ["//visibility:public"],
)
