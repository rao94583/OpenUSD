"""Bazel build for OpenUSD.

The CMake build remains the reference build. Third-party C++ dependencies
are vendored as source under vendor/; only Bazel rule sets and the hermetic
Python toolchain are fetched from the Bazel Central Registry, and usdview's
prebuilt Python dependencies (PySide6, PyOpenGL) from PyPI, pinned by hash in
bazel/requirements_lock.txt.
"""

module(
    name = "openusd",
    version = "0.27.2",
)

# apple_support must precede rules_cc so its Xcode-aware C++ toolchain is
# registered ahead of the auto-configured one.
bazel_dep(name = "apple_support", version = "2.10.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_apple", version = "5.3.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "2.4.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//bazel:requirements_lock.txt",
)
use_repo(pip, "pypi")
