# Scenes in the packages' public test trees, as runfiles paths.
SNAPSHOT_SCENES = [
    "pxr/usdImaging/bin/usdrecord/tests/ctest/RecordTest/AnimCube.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLNativeImplicits/niSpheres.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceDomeLight.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceNormalMap.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceTexture.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLSubdivisionOsd3/subdivMesh.usda",
]

# Phase 2: the viewport's image matches usdrecord's for the same view.
py_test(
    name = "snapshot_test",
    srcs = ["test_snapshot.py"],
    main = "test_snapshot.py",
    args = [
        "$(rootpath :archive)",
        "$(rootpath //pxr/usdImaging/bin/usdrecord)",
        "$(rootpath //vendor/openimageio:idiff)",
    ] + SNAPSHOT_SCENES,
    data = [
        "snapshot_camera.py",
        ":archive",
        "//pxr/usdImaging/bin/usdrecord",
        "//pxr/usdImaging/bin/usdrecord:test_tree",
        "//pxr/usdImaging/usdImagingGL:test_tree",
        "//vendor/openimageio:idiff",
    ],
    tags = ["requires-darwin"],
)

# Phase 2: interactive frame rate on a large scene. Manual, since it depends
# on the machine: bazel test //app/vela:benchmark_test --test_output=all
py_test(
    name = "benchmark_test",
    size = "large",
    srcs = ["test_benchmark.py"],
    main = "test_benchmark.py",
    args = ["$(rootpath :archive)"],
    data = [
        "make_large_scene.py",
        ":archive",
    ],
    tags = [
        "exclusive",
        "manual",
        "requires-darwin",
    ],
)

py_test(
    name = "browser_ui_test",
    srcs = ["test_browser.py"],
    main = "test_browser.py",
    # Real scenes: typical schema prims (whose first property is often an
    # untargeted relationship), native instancing, references and materials.
    args = ["$(rootpath :archive)"] + SNAPSHOT_SCENES,
    data = [
        ":archive",
        "//pxr/usdImaging/bin/usdrecord:test_tree",
        "//pxr/usdImaging/usdImagingGL:test_tree",
    ],
    tags = ["requires-darwin"],
)

