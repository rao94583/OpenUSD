load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load(":bundle.bzl", "usd_headers", "vela_runtime", "vela_archive")

usd_headers(
    name = "usd_headers",
    deps = [
        "//pxr/base/plug",
        "//pxr/imaging/hgiMetal",
        "//pxr/imaging/hio",
        "//pxr/usd/usd",
        "//pxr/usd/usdGeom",
        "//pxr/usdImaging/usdImagingGL",
    ],
)

cc_import(
    name = "usd_shared",
    shared_library = "//bazel/install:usd_ms",
)

# Plain C++ with no AppKit: camera math (and, from Phase 3, the document).
cc_library(
    name = "core",
    srcs = [
        "core/actions.cpp",
        "core/browser.cpp",
        "core/document.cpp",
        "core/editing_actions.cpp",
        "core/free_camera.cpp",
        "core/standard_actions.cpp",
        "core/undo.cpp",
    ],
    hdrs = [
        "core/actions.h",
        "core/browser.h",
        "core/document.h",
        "core/free_camera.h",
        "core/undo.h",
    ],
    copts = ["-std=c++20"],
    deps = [
        ":usd_headers",
        ":usd_shared",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

cc_test(
    name = "free_camera_test",
    srcs = ["core/free_camera_test.cpp"],
    deps = [":core"],
)

# Core tests that open stages: USD's plugin resources come from the install
# tree in runfiles (see core/test_support.h).
[cc_test(
    name = name,
    srcs = [
        "core/%s.cpp" % name,
        "core/test_support.h",
    ],
    copts = ["-std=c++20"],
    data = ["//bazel/install:resources"],
    deps = [":core"],
) for name in [
    "actions_test",
    "browser_test",
    "editing_actions_test",
    "document_test",
    "undo_test",
]]

objc_library(
    name = "frontend",
    srcs = [
        "browser_view.h",
        "browser_view.mm",
        "document.h",
        "document.mm",
        "main.mm",
        "menus.h",
        "menus.mm",
        "viewport/renderer.h",
        "viewport/renderer.mm",
        "viewport/viewport_view.h",
        "viewport/viewport_view.mm",
    ],
    copts = ["-fobjc-arc"],
    sdk_frameworks = [
        "AppKit",
        "Metal",
        "QuartzCore",
    ],
    deps = [
        ":core",
        ":usd_headers",
        ":usd_shared",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

py_binary(name = "copy_runtime", srcs = ["copy_runtime.py"])
py_binary(name = "sign_runtime", srcs = ["sign_runtime.py"])
vela_runtime(name = "runtime", usd = ["//bazel/install:python"])

macos_application(
    name = "Vela",
    bundle_id = "org.openusd.vela",
    minimum_os_version = "13.0",
    infoplists = ["Info.plist"],
    deps = [":frontend"],
    additional_contents = {":runtime": "Resources/Runtime"},
    ipa_post_processor = ":sign_runtime",
    linkopts = [
        "-rpath", "@executable_path/../Resources/Runtime/usd/lib",
        "-rpath", "@executable_path/../Resources/Runtime/python/lib",
    ],
)

vela_archive(name = "archive", app = ":Vela")

py_test(
    name = "bundle_smoke_test",
    srcs = ["test_bundle.py"],
    main = "test_bundle.py",
    args = ["$(location :archive)"],
    data = [":archive"],
    tags = ["requires-darwin"],
)

# Phase 3: menus are built from the action registry.
py_test(
    name = "menus_test",
    srcs = ["test_menus.py"],
    main = "test_menus.py",
    args = ["$(rootpath :archive)"],
    data = [":archive"],
    tags = ["requires-darwin"],
)

# Scenes in the packages' public test trees, as runfiles paths.
SNAPSHOT_SCENES = [
    "pxr/usdImaging/bin/usdrecord/tests/ctest/RecordTest/AnimCube.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLNativeImplicits/niSpheres.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceDomeLight.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceNormalMap.usda",
    "pxr/usdImaging/usdImagingGL/tests/ctest/testUsdImagingGLPreviewSurface/testPreviewSurfaceTexture.usda",
]

# Phase 2: the viewport's image matches usdrecord's for the same view.
py_test(
    name = "snapshot_test",
    srcs = ["test_snapshot.py"],
    main = "test_snapshot.py",
    args = [
        "$(rootpath :archive)",
        "$(rootpath //pxr/usdImaging/bin/usdrecord)",
        "$(rootpath //vendor/openimageio:idiff)",
    ] + SNAPSHOT_SCENES,
    data = [
        "snapshot_camera.py",
        ":archive",
        "//pxr/usdImaging/bin/usdrecord",
        "//pxr/usdImaging/bin/usdrecord:test_tree",
        "//pxr/usdImaging/usdImagingGL:test_tree",
        "//vendor/openimageio:idiff",
    ],
    tags = ["requires-darwin"],
)

# Phase 2: interactive frame rate on a large scene. Manual, since it depends
# on the machine: bazel test //app/vela:benchmark_test --test_output=all
py_test(
    name = "benchmark_test",
    size = "large",
    srcs = ["test_benchmark.py"],
    main = "test_benchmark.py",
    args = ["$(rootpath :archive)"],
    data = [
        "make_large_scene.py",
        ":archive",
    ],
    tags = [
        "exclusive",
        "manual",
        "requires-darwin",
    ],
)

py_test(
    name = "browser_ui_test",
    srcs = ["test_browser.py"],
    main = "test_browser.py",
    args = ["$(rootpath :archive)"],
    data = [":archive"],
    tags = ["requires-darwin"],
)
