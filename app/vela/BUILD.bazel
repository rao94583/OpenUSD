load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load(":bundle.bzl", "usd_headers", "vela_runtime", "vela_archive")

usd_headers(
    name = "usd_headers",
    deps = [
        "//pxr/base/plug",
        "//pxr/imaging/hgiMetal",
        "//pxr/imaging/hio",
        "//pxr/usd/usd",
        "//pxr/usd/usdGeom",
        "//pxr/usd/usdRender",
        "//pxr/usd/usdUtils",
        "//pxr/usdImaging/usdImagingGL",
        "//pxr/usdValidation/usdUtilsValidators",
        "//pxr/usdValidation/usdValidation",
    ],
)

cc_import(
    name = "opencolorio_shared",
    shared_library = "//bazel/install:opencolorio",
)

cc_import(
    name = "usd_shared",
    shared_library = "//bazel/install:usd_ms",
)

# The vela Python module's source, compiled into the core as a string.
genrule(
    name = "vela_module_source",
    srcs = ["core/vela_module.py"],
    outs = ["core/vela_module.inc"],
    cmd = "(echo 'R\"vela_py('; cat $<; echo ')vela_py\"') > $@",
)

# Plain C++ with no AppKit: the document, actions, undo, Python and MCP.
cc_library(
    name = "core",
    srcs = [
        "core/actions.cpp",
        "core/app_settings.cpp",
        "core/browser.cpp",
        "core/claude_cli.cpp",
        "core/claude_history.cpp",
        "core/claude_process.cpp",
        "core/color_codes.cpp",
        "core/color_management.cpp",
        "core/document.cpp",
        "core/editing_actions.cpp",
        "core/export_framing.cpp",
        "core/file_actions.cpp",
        "core/free_camera.cpp",
        "core/hud.cpp",
        "core/image_jobs.cpp",
        "core/launch_options.cpp",
        "core/log.cpp",
        "core/mcp.cpp",
        "core/mcp_socket.cpp",
        "core/palette.cpp",
        "core/plugins.cpp",
        "core/python.cpp",
        "core/session.cpp",
        "core/standard_actions.cpp",
        "core/undo.cpp",
        "core/validation.cpp",
        "core/value_text.cpp",
        "core/view_actions.cpp",
        "core/view_settings.cpp",
    ],
    hdrs = [
        "core/actions.h",
        "core/app_settings.h",
        "core/browser.h",
        "core/claude_cli.h",
        "core/claude_history.h",
        "core/claude_process.h",
        "core/color_codes.h",
        "core/color_management.h",
        "core/document.h",
        "core/export_framing.h",
        "core/free_camera.h",
        "core/hud.h",
        "core/image_jobs.h",
        "core/launch_options.h",
        "core/log.h",
        "core/mcp.h",
        "core/mcp_path.h",
        "core/mcp_socket.h",
        "core/palette.h",
        "core/plugins.h",
        "core/python.h",
        "core/session.h",
        "core/undo.h",
        "core/validation.h",
        "core/value_text.h",
        "core/view_settings.h",
    ],
    textual_hdrs = [":vela_module_source"],
    copts = ["-std=c++20"],
    deps = [
        ":usd_headers",
        ":usd_shared",
        # For listing OCIO config choices, from the same shared OpenColorIO
        # library Storm uses.
        ":opencolorio_shared",
        "//vendor/opencolorio:headers",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

cc_test(
    name = "free_camera_test",
    srcs = ["core/free_camera_test.cpp"],
    deps = [":core"],
)

# Core tests that open stages: USD's plugin resources come from the install
# tree in runfiles (see core/test_support.h).
[cc_test(
    name = name,
    srcs = [
        "core/%s.cpp" % name,
        "core/test_support.h",
    ],
    copts = ["-std=c++20"],
    data = ["//bazel/install:resources"],
    deps = [":core"],
) for name in [
    "actions_test",
    "app_settings_test",
    "browser_test",
    "claude_test",
    "editing_actions_test",
    "export_framing_test",
    "file_actions_test",
    "hud_test",
    "image_jobs_test",
    "launch_options_test",
    "log_test",
    "mcp_test",
    "material_invalidation_test",
    "palette_test",
    "plugins_test",
    "document_test",
    "undo_test",
    "validation_test",
    "value_text_test",
]]

objc_library(
    name = "frontend",
    srcs = [
        "bottom_panel.h",
        "bottom_panel.mm",
        "browser_view.h",
        "browser_view.mm",
        "claude_markdown.h",
        "claude_markdown.mm",
        "claude_panel.h",
        "claude_panel.mm",
        "color_coding.h",
        "color_coding.mm",
        "document.h",
        "document.mm",
        "form_sheet.h",
        "form_sheet.mm",
        "log_view.h",
        "log_view.mm",
        "main.mm",
        "image_generation.h",
        "image_generation.mm",

        "menus.h",
        "menus.mm",
        "palette.h",
        "palette.mm",
        "plugins_ui.h",
        "plugins_ui.mm",
        "python_console.h",
        "python_console.mm",
        "scripting.h",
        "scripting.mm",
        "settings_window.h",
        "settings_window.mm",
        "validation_panel.h",
        "validation_panel.mm",
        "spline_view.h",
        "spline_view.mm",
        "window_layout.h",
        "window_layout.mm",
        "viewport/hud_view.h",
        "viewport/hud_view.mm",
        "viewport/movie_writer.h",
        "viewport/movie_writer.mm",
        "viewport/renderer.h",
        "viewport/renderer.mm",
        "viewport/viewport_view.h",
        "viewport/viewport_view.mm",
    ],
    copts = ["-fobjc-arc", "-std=c++20"],
    sdk_frameworks = [
        "AVFoundation",
        "AppKit",
        "CoreMedia",
        "CoreVideo",
        "Metal",
        "QuartzCore",
        "Security",
        "ImageIO",
        "UniformTypeIdentifiers",
    ],
    textual_hdrs = [
        ":image_instructions",
        ":plugin_instructions",
    ],
    deps = [
        ":core",
        ":image_provider",
        ":usd_headers",
        ":usd_shared",
        "@rules_python//python/cc:current_py_cc_libs",
    ],
)

py_binary(name = "copy_runtime", srcs = ["copy_runtime.py"])
py_binary(name = "sign_runtime", srcs = ["sign_runtime.py"])
vela_runtime(
    name = "runtime",
    # PyObjC, for plugins that make AppKit UI.
    site_packages = [
        "@pypi//pyobjc_core:pkg",
        "@pypi//pyobjc_framework_cocoa:pkg",
    ],
    usd = ["//bazel/install:python"],
)

# vela-mcp, in Contents/MacOS: bridges an MCP client's stdio to the app's
# socket. It links nothing of USD's.
cc_binary(
    name = "vela-mcp",
    srcs = [
        "core/mcp_path.h",
        "mcp_bridge.cpp",
    ],
    copts = ["-std=c++20"],
)

macos_application(
    name = "Vela",
    bundle_id = "org.openusd.vela",
    minimum_os_version = "13.0",
    infoplists = ["Info.plist"],
    deps = [":frontend"],
    additional_contents = {
        ":runtime": "Resources/Runtime",
        ":vela-mcp": "MacOS",
    },
    ipa_post_processor = ":sign_runtime",
    linkopts = [
        "-rpath", "@executable_path/../Resources/Runtime/usd/lib",
        "-rpath", "@executable_path/../Resources/Runtime/python/lib",
    ],
)

vela_archive(name = "archive", app = ":Vela")

py_test(
    name = "bundle_smoke_test",
    srcs = ["test_bundle.py"],
    main = "test_bundle.py",
    args = ["$(location :archive)"],
    data = [":archive"],
    tags = ["requires-darwin"],
)

# Phase 3: menus are built from the action registry.
py_test(
    name = "menus_test",
    srcs = ["test_menus.py"],
    main = "test_menus.py",
    args = ["$(rootpath :archive)"],
    data = [":archive"],
    tags = ["requires-darwin"],
)

# Phase 5: usdview's command-line options, through a real launch.
py_test(
    name = "launch_test",
