#usda 1.0
(
    defaultPrim = "Shelf"
    upAxis = "Y"
)

# A bookshelf, loaded by playroom.usda as a payload: try Prim → Unload.
def Xform "Shelf" (
    kind = "component"
)
{
    def Cube "Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 1.2, -0.2)
        float3 xformOp:scale = (2.4, 2.4, 0.06)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Shelf/Paint>
    }

    def Cube "Board1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 0.4, 0)
        float3 xformOp:scale = (2.4, 0.06, 0.45)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Shelf/Paint>
    }

    def Cube "Board2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 1.3, 0)
        float3 xformOp:scale = (2.4, 0.06, 0.45)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Shelf/Paint>
    }

    def Cube "Board3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double3 xformOp:translate = (0, 2.2, 0)
        float3 xformOp:scale = (2.4, 0.06, 0.45)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Shelf/Paint>
    }

    def Xform "Books"
    {
        def Cube "Book1"
        {
            double size = 1
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.15, 0.3, 0.6)]
            double3 xformOp:translate = (-0.9, 0.73, 0)
            float3 xformOp:scale = (0.12, 0.6, 0.35)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Book2"
        {
            double size = 1
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.7, 0.2, 0.15)]
            double3 xformOp:translate = (-0.75, 0.68, 0)
            float3 xformOp:scale = (0.1, 0.5, 0.33)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Book3"
        {
            double size = 1
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.2, 0.55, 0.3)]
            double3 xformOp:translate = (-0.6, 0.75, 0)
            float3 xformOp:scale = (0.14, 0.64, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Book4"
        {
            double size = 1
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.85, 0.7, 0.2)]
            double3 xformOp:translate = (0.5, 1.6, 0)
            double3 xformOp:rotateXYZ = (0, 0, -12)
            float3 xformOp:scale = (0.12, 0.55, 0.34)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }

    def Material "Paint"
    {
        token outputs:surface.connect = </Shelf/Paint/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.92, 0.9, 0.86)
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }
}
